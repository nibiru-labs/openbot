# The environment of the account service (apps/auth-api).
#
# Copy this file to /etc/openbot/auth-api.env, fill in the values, and keep it out of the
# repository. The file holds secrets. The Git rule `deploy/self-host/env/*.env` ignores a copy
# that stays in the repository.
#
#   sudo install -d -m 0750 -o root -g openbot /etc/openbot
#   sudo install -m 0640 -o root -g openbot deploy/self-host/env/auth-api.env.example \
#     /etc/openbot/auth-api.env
#   sudoedit /etc/openbot/auth-api.env
#
# The local runtime reads the six secrets below from the environment. The other values, such as
# the mail server and the address of Signal, are in the `vars` section of
# apps/auth-api/wrangler.jsonc. Change that file for this deployment, as the guide
# docs/self-hosting.md describes.

# The password of the mail account. The sign-in code comes from this account.
EMAIL_SMTP_PASSWORD=replace-with-the-password-of-your-mail-account

# The token of the marketplace administration.
SKILLS_ADMIN_TOKEN=replace-with-a-random-value-of-48-bytes

# The secret of the report hashes.
SITE_REPORT_HASH_SECRET=replace-with-a-random-value-of-48-bytes

# The ticket key pair. The command in step 1 of docs/self-hosting.md makes the values. The
# Signal service reads the public key from the JWKS of the account service.
REMOTE_TICKET_PRIVATE_JWK='{"kty":"EC","crv":"P-256","d":"replace-me","x":"replace-me","y":"replace-me"}'
REMOTE_TICKET_PUBLIC_JWKS='{"keys":[{"kty":"EC","crv":"P-256","x":"replace-me","y":"replace-me","kid":"self-hosted-1","alg":"ES256","use":"sig"}]}'

# The secret of the account events. The Signal service uses the same value.
REMOTE_AUTH_WEBHOOK_SECRET=replace-with-a-random-value-of-48-bytes
